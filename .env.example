APP_NAME=API_Nyaa
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_FORMAT=text
ENABLE_DOCS=true
API_TOKEN=

NYAA_BASE_URL=https://nyaa.si
# Verrouillé : toute autre valeur empêche le démarrage.
NYAA_CATEGORY_ID=3_1
USER_AGENT=API_Nyaa/0.1 (+private-selfhosted)
REQUEST_TIMEOUT_SECONDS=20
REQUEST_MAX_RETRIES=2
UPSTREAM_REQUESTS_PER_SECOND=1
UPSTREAM_MAX_CONCURRENCY=2

DB_PATH=./data/cache.sqlite3
# Plafonds de référence. Le Compose de production les fixe sans surcharge .env.
DATA_HARD_LIMIT_BYTES=350000000
CACHE_DB_TARGET_BYTES=256000000
SQLITE_WAL_HARD_LIMIT_BYTES=32000000
MAX_CACHE_ENTRY_BYTES=5000000
SQLITE_BUSY_TIMEOUT_MS=5000
CACHE_MEMORY_ENTRIES=512
DEBUG_CAPTURE_HTML_ON_ERROR=false
DEBUG_MAX_BYTES=50000000
CACHE_TTL_SEARCH_SECONDS=300
CACHE_TTL_DETAIL_SECONDS=21600
CACHE_STALE_GRACE_SECONDS=604800
NEGATIVE_CACHE_TTL_SECONDS=120

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
DEFAULT_LIMIT=25
MAX_LIMIT=75
MAX_DETAIL_ENRICHMENTS=10
